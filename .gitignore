faiss_index/

# ChromaDB (auto-generated vector store)
chroma_db/

# Logs
*.log
logs/

# Testing
tests/
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Ignored directories
Interview Questions/
graphify-out/
.agents/
.planning/

# Ignored files
rules.md