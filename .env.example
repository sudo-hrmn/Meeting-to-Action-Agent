# Environment variables for Meeting-to-Action Agent
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key — get yours free at https://console.groq.com (no credit card)
GROQ_API_KEY=gsk_your_key_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Tavily API key — for web search (Phase 5 feature, not required for Phase 1-4)
TAVILY_API_KEY=

# HuggingFace token — not needed since we use ChromaDB's built-in embeddings
HUGGINGFACEHUB_API_TOKEN=

# ── App Config (defaults shown) ───────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to true for detailed FastAPI error messages (development only)
DEBUG=false

# LLM model — see available models at https://console.groq.com/docs/models
# Fast & free options: llama-3.1-8b-instant, llama-3.1-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# Temperature: 0.0 = deterministic, 1.0 = creative
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
