# Environment variables for Meeting-to-Action Agent
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key — get yours free at https://console.groq.com (no credit card)
GROQ_API_KEY=gsk_your_key_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Tavily API key — for web search
TAVILY_API_KEY=

# LangSmith Tracing & Observability — get API key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=Meeting-to-Action-Agent
# ── App Config (defaults shown) ───────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to true for detailed FastAPI error messages (development only)
DEBUG=false

# LLM model — see available models at https://console.groq.com/docs/models
# Fast & free options: groq/compound-mini, qwen/qwen3.6-27b, groq/compound
GROQ_MODEL=groq/compound-mini

# Temperature: 0.0 = deterministic, 1.0 = creative
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
